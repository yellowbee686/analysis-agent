# Copy to .env and fill in your keys/settings.
# API keys are configured in models/model_config/base.yaml (private).

# Optional: model selection
LOCAL_AGENT_MODEL_PLATFORM=openai-compatible-model
LOCAL_AGENT_MODEL_TYPE=deepseek-ai/deepseek-v3.2

# Optional: model config file (defaults to models/model_config/base.yaml if present,
# otherwise models/model_config/base.yaml.example)
# LOCAL_AGENT_MODEL_CONFIG=models/model_config/base.yaml

# Optional Azure-compatible API version override
# LOCAL_AGENT_AZURE_API_VERSION=2024-03-01-preview
