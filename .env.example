# Copy to .env and fill in your keys/settings.
# Model selection (optional)
LOCAL_AGENT_MODEL_PLATFORM=openai
LOCAL_AGENT_MODEL_TYPE=gpt-4.1-mini-2025-04-14
LOCAL_AGENT_MAX_TOKENS=65535
LOCAL_AGENT_STREAM=true

# System prompt override (optional)
# LOCAL_AGENT_SYSTEM_PROMPT=You are a helpful local file assistant.

# OpenAI (example)
# OPENAI_API_KEY=your_key_here

# Multi-key endpoints for gemini-3-pro-preview-new
# GEMINI_3_PRO_BASE_URL_1=https://genai-sg-og.tiktok-row.org/gpt/openapi/online/v2/crawl/openai/deployments/gpt_openapi
# GEMINI_3_PRO_API_KEY_1=your_key_here
# GEMINI_3_PRO_WEIGHT_1=1
# GEMINI_3_PRO_BASE_URL_2=https://genai-sg-og.tiktok-row.org/gpt/openapi/online/v2/crawl/openai/deployments/gpt_openapi
# GEMINI_3_PRO_API_KEY_2=your_key_here
# GEMINI_3_PRO_WEIGHT_2=1
# GEMINI_3_PRO_BASE_URL_3=https://genai-sg-og.tiktok-row.org/gpt/openapi/online/v2/crawl/openai/deployments/gpt_openapi
# GEMINI_3_PRO_API_KEY_3=your_key_here
# GEMINI_3_PRO_WEIGHT_3=1

# Multi-key endpoints for gpt-5.2-2025-12-11
# GPT5_2_BASE_URL_1=https://genai-sg-og.tiktok-row.org/gpt/openapi/online/v2/crawl/openai/deployments/gpt_openapi
# GPT5_2_API_KEY_1=your_key_here
# GPT5_2_WEIGHT_1=1
# GPT5_2_BASE_URL_2=https://genai-sg-og.tiktok-row.org/gpt/openapi/online/v2/crawl/openai/deployments/gpt_openapi
# GPT5_2_API_KEY_2=your_key_here
# GPT5_2_WEIGHT_2=1

# Optional Azure-compatible API version override
# LOCAL_AGENT_AZURE_API_VERSION=2024-03-01-preview
